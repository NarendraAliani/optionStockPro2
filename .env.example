# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=option_signal_pro
DB_USER=root
DB_PASSWORD=
